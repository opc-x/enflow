            "type": "command",
            "command": "python3 -c \"\nimport subprocess,json,os\nlog=subprocess.run(['tail','-40','/tmp/tauri-dev.log'],capture_output=True,text=True).stdout\nerrs=[l.strip() for l in log.splitlines() if any(k in l for k in ['error[E','panicked','FAILED','error while running'])]\npaste=open('/tmp/paste_debug.txt').read().strip() if os.path.exists('/tmp/paste_debug.txt') else ''\nctx=[]\nif errs:ctx.append('TAURI_ERRORS: '+' | '.join(errs[-3:]))\nif paste:ctx.append('PASTE_DEBUG: '+paste)\nif ctx:print(json.dumps({'hookSpecificOutput':{'hookEventName':'PostToolUse','additionalContext':'\\n'.join(ctx)}}))\n\" 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
